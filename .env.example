# ================================
# DISCORD BOT CONFIGURATION
# ================================

# Token bot Discord kamu (dari https://discord.com/developers/applications)
DISCORD_TOKEN=TOKEN_BOT_DISINI

# Client ID bot Discord kamu
CLIENT_ID=CLIENT_ID_BOT_DISINI

# ================================
# SPOTIFY CONFIGURATION (Optional)
# ================================
# Dapat dari https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ================================
# PENGATURAN BOT
# ================================

# Prefix untuk text commands (opsional, bot pakai slash commands)
PREFIX=!

# Volume default (0-100)
DEFAULT_VOLUME=50

# Waktu timeout jika tidak ada yang di voice channel (dalam milidetik)
# 300000 = 5 menit
LEAVE_ON_EMPTY_COOLDOWN=30000
LEAVE_ON_STOP_COOLDOWN=30000

# ================================
# PROXY CONFIGURATION (Sangat Direkomendasikan!)
# ================================
# Proxy sangat penting untuk menghindari rate limit YouTube (429)
# dan bot-check di IP datacenter. Tanpa proxy, bot sering error.
#
# Opsi 1: Banyak proxy (DIREKOMENDASIKAN — rotasi otomatis)
# Format: dipisahkan koma. Mendukung HTTP, HTTPS, SOCKS5
# PROXY_URLS=http://user:pass@proxy1:port,http://user:pass@proxy2:port,socks5://proxy3:port
#
# Opsi 2: Single proxy (fallback jika PROXY_URLS tidak diset)
# PROXY_URL=http://user:pass@proxy:port
#
# Provider proxy murah yang direkomendasikan:
#   - Webshare.io      → 10 proxy gratis, $5.49/bulan untuk 100 proxy
#   - ProxyScrape       → Residential proxy mulai $3/bulan
#   - SmartProxy        → Residential rotating proxy
#   - BrightData        → Premium residential proxy
#
# Tips: Gunakan RESIDENTIAL proxy (bukan datacenter) untuk hasil terbaik!
PROXY_URLS=
PROXY_URL=

# ================================
# SAWERIA DONATION WEBHOOK
# ================================
# Port lokal untuk mendengarkan webhook Saweria (Default: 3000)
SAWERIA_PORT=3000

# URL publik bot kamu (misal: https://bot.domainkamu.com atau http://IP_VPS:3000)
# Digunakan untuk menampilkan URL webhook lengkap di perintah /qsaweria status
SAWERIA_PUBLIC_URL=http://localhost:3000

# Secret token keamanan untuk validasi request Saweria (Opsional)
SAWERIA_SECRET=

# Link Saweria kamu untuk tombol direct link pada embed
SAWERIA_URL=https://saweria.co/qumpruy

