# ================================
# DISCORD BOT CONFIGURATION
# ================================

# Token bot Discord kamu (dari https://discord.com/developers/applications)
DISCORD_TOKEN=TOKEN_BOT_DISINI

# Client ID bot Discord kamu
CLIENT_ID=CLIENT_ID_BOT_DISINI

# ================================
# SPOTIFY CONFIGURATION (Optional)
# ================================
# Dapat dari https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ================================
# PENGATURAN BOT
# ================================

# Prefix untuk text commands (opsional, bot pakai slash commands)
PREFIX=!

# Volume default (0-100)
DEFAULT_VOLUME=50

# Waktu timeout jika tidak ada yang di voice channel (dalam milidetik)
# 300000 = 5 menit
LEAVE_ON_EMPTY_COOLDOWN=30000
LEAVE_ON_STOP_COOLDOWN=30000

# ================================
# SAWERIA DONATION WEBHOOK
# ================================
# Port lokal untuk mendengarkan webhook Saweria (Default: 3000)
SAWERIA_PORT=3000

# URL publik bot kamu (misal: https://bot.domainkamu.com atau http://IP_VPS:3000)
# Digunakan untuk menampilkan URL webhook lengkap di perintah /qsaweria status
SAWERIA_PUBLIC_URL=http://localhost:3000

# Secret token keamanan untuk validasi request Saweria (Opsional tapi direkomendasikan)
# Jika diisi, tambahkan ?token=SECRET_KAMU di akhir URL webhook Saweria
SAWERIA_SECRET=

# (Opsional) Discord Webhook URL fallback global
SAWERIA_DISCORD_WEBHOOK_URL=

# (Opsional) Text Channel ID default untuk notifikasi donasi
SAWERIA_DEFAULT_CHANNEL_ID=

